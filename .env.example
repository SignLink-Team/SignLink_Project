# App
APP_NAME=Sign Language Backend
DEBUG=true

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=sign_language

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Server
AI_SERVER_URL=http://localhost:8001
AI_SERVER_WS_URL=ws://localhost:8001
AI_PREDICT_PATH=/api/v1/predict
AI_PREDICT_WS_PATH=/ws/predict
AI_REQUEST_TIMEOUT_SECONDS=5.0
AI_STREAM_RESULT_TIMEOUT_SECONDS=150.0

# sLLM server (Ollama or another OpenAI-compatible server)
SIGNLINK_SKIP_LLM=false
SIGNLINK_LLM_BASE_URL=http://localhost:11434
SIGNLINK_LLM_MODEL=sign-ko-qwen25-3b-v2
SIGNLINK_LLM_TIMEOUT_SECONDS=120
# 0 keeps the sLLM on CPU so the sign-recognition model can use the GPU.
SIGNLINK_LLM_NUM_GPU=0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
